{
  "name": "mainstation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:art-migration": "tsx scripts/generate-character-art-migration.ts",
    "generate:seed": "tsx scripts/generate-supabase-seed.ts",
    "generate:roster-migration": "tsx scripts/generate-roster-migration.ts",
    "verify:art": "tsx scripts/verify-art-assets.ts",
    "prebuild": "npm run generate:icons",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "lint:db": "supabase db lint --local --schema public --level warning --fail-on error",
    "test:e2e": "npm run build && playwright test",
    "validate": "npm run lint && npm run typecheck && npm run verify:art && npm test && npm run build",
    "deploy": "npm run validate && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@supabase/supabase-js": "2.112.4",
    "idb": "8.0.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260823.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "fake-indexeddb": "6.2.5",
    "globals": "17.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.0.1",
    "sharp": "0.35.3",
    "supabase": "2.115.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.125.0",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
